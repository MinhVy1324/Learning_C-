using System;
using System.Drawing;
using System.Windows.Forms;

namespace Bai1_ThucHanh6c
{
    public partial class Form1 : Form
    {
        private Button btnQuanLyHang;
        private Button btnQuanLyKhach;
        private Button btnThoat;
        private Label lblTitle;

        public Form1()
        {
            InitializeComponent();
            TaoGiaoDienChinh();
        }

        private void TaoGiaoDienChinh()
        {
            this.Text = "QLCuaHang - Chính";
            this.ClientSize = new Size(420, 200);
            this.StartPosition = FormStartPosition.CenterScreen;
            this.Font = new Font("Segoe UI", 10);
            this.FormBorderStyle = FormBorderStyle.FixedSingle;
            this.MaximizeBox = false;

            lblTitle = new Label();
            lblTitle.Text = "Quản lý cửa hàng";
            lblTitle.Font = new Font(this.Font.FontFamily, 14, FontStyle.Bold);
            lblTitle.AutoSize = true;
            lblTitle.SetBounds(20, 15, 380, 30);
            this.Controls.Add(lblTitle);

            btnQuanLyHang = new Button();
            btnQuanLyHang.Text = "Quản lý hàng";
            btnQuanLyHang.SetBounds(30, 60, 340, 30);
            btnQuanLyHang.Click += BtnQuanLyHang_Click;
            this.Controls.Add(btnQuanLyHang);

            btnQuanLyKhach = new Button();
            btnQuanLyKhach.Text = "Quản lý khách";
            btnQuanLyKhach.SetBounds(30, 100, 340, 30);
            btnQuanLyKhach.Click += BtnQuanLyKhach_Click;
            this.Controls.Add(btnQuanLyKhach);

            btnThoat = new Button();
            btnThoat.Text = "Thoát";
            btnThoat.SetBounds(30, 140, 340, 30);
            btnThoat.Click += BtnThoat_Click;
            this.Controls.Add(btnThoat);
        }

        private void BtnQuanLyHang_Click(object? sender, EventArgs e)
        {
            MessageBox.Show("Mở chức năng Quản lý hàng (chưa triển khai).", "Thực thi", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnQuanLyKhach_Click(object? sender, EventArgs e)
        {
            MessageBox.Show("Mở chức năng Quản lý khách (chưa triển khai).", "Thực thi", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnThoat_Click(object? sender, EventArgs e)
        {
            this.Close();
        }

        // Designer cung cấp InitializeComponent trong Form1.Designer.cs
    }
}
