using System;

namespace MyLib
{
    public class Person
    {
        public int Id { get; set; } = 0;
        public string Name { get; set; } = string.Empty;
        public int Yob { get; set; } = 0; // year of birth
        public int Yod { get; set; } = 0; // year of death

        public Person()
        {
            Id = 0;
            Name = string.Empty;
            Yob = 0;
            Yod = 0;
        }

        public Person(int id, string name, int yob, int yod)
        {
            Id = id;
            Name = name;
            Yob = yob;
            Yod = yod;
        }

        public Person(Person other)
        {
            Id = other.Id;
            Name = other.Name;
            Yob = other.Yob;
            Yod = other.Yod;
        }

        public bool IsLiving()
        {
            return Yod == 0;
        }

        public static Person Input()
        {
            Person p = new Person();

            int id;
            while (true)
            {
                Console.Write("Nhập ID (số nguyên): ");
                if (int.TryParse(Console.ReadLine(), out id))
                {
                    p.Id = id;
                    break;
                }
                Console.WriteLine("Lỗi: ID phải là số nguyên!");
            }

            Console.Write("Nhập Họ và Tên: ");
            p.Name = Console.ReadLine() ?? string.Empty;

            int yob;
            while (true)
            {
                Console.Write("Nhập Năm sinh (YOB): ");
                if (int.TryParse(Console.ReadLine(), out yob) && yob >= 0)
                {
                    p.Yob = yob;
                    break;
                }
                Console.WriteLine("Lỗi: Năm sinh phải là số nguyên không âm!");
            }

            int yod;
            while (true)
            {
                Console.Write("Nhập Năm mất (YOD - Nhập 0 nếu còn sống): ");
                if (int.TryParse(Console.ReadLine(), out yod) && yod >= 0)
                {
                    p.Yod = yod;
                    break;
                }
                Console.WriteLine("Lỗi: Năm mất phải là số nguyên không âm!");
            }

            return p;
        }

        public void Output()
        {
            Console.WriteLine($"[ID: {Id}] - Tên: {Name} | Năm sinh: {Yob} | Trạng thái: {(IsLiving() ? "Còn sống" : $"Đã mất ({Yod})")}");
        }

        public override string ToString()
        {
            return $"ID: {Id}, Name: {Name}, YOB: {Yob}, YOD: {Yod}, IsLiving: {IsLiving()}";
        }
    }
}